{
  "name": "lockwright-app-browser-extension",
  "private": true,
  "version": "0.0.25",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.10.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "dev": "vite",
    "build:main": "vite build --config vite.config.main.js",
    "build:content": "vite build --config vite.config.content.js",
    "build:background": "vite build --config vite.config.background.js",
    "build:inject": "vite build --config vite.config.inject.js",
    "build": "pnpm run lingui:extract && pnpm run lingui:compile && pnpm run build:main && pnpm run build:content && pnpm run build:background && pnpm run build:inject",
    "build:firefox": "pnpm run build && node scripts/package-firefox.mjs",
    "build:chrome": "pnpm run build && node scripts/package-chrome.mjs",
    "build:watch:main": "vite build --watch --config vite.config.main.js --mode development",
    "build:watch:content": "vite build --watch --config vite.config.content.js --mode development",
    "build:watch:background": "vite build --watch --config vite.config.background.js --mode development",
    "build:watch:inject": "vite build --watch --config vite.config.inject.js --mode development",
    "build:watch": "npm-run-all --parallel lingui:extract lingui:compile build:watch:main build:watch:content build:watch:background build:watch:inject",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "lint:fix": "eslint --fix ./src",
    "lint": "eslint ./src",
    "prepare": "husky",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "knip": "knip"
  },
  "dependencies": {
    "@lingui/core": "5.1.2",
    "@lingui/format-json": "5.1.2",
    "@lingui/react": "5.1.2",
    "@lingui/vite-plugin": "5.3.1",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.6",
    "@reduxjs/toolkit": "2.5.0",
    "@tailwindcss/vite": "4.1.4",
    "@tetherto/pear-apps-lib-feedback": "git+https://github.com/tetherto/pear-apps-lib-feedback.git#f616c1c1f9b9774d17595acf864055674fae64fd",
    "@tetherto/pear-apps-lib-ui-react-hooks": "git+https://github.com/tetherto/pear-apps-lib-ui-react-hooks.git#8273bf9e248bbdaacbfb0b7a16d5b63687990481",
    "@tetherto/pear-apps-utils-avatar-initials": "git+https://github.com/tetherto/pear-apps-utils-avatar-initials.git#986772c039e88e519ca9da93837df3223a6f335e",
    "@tetherto/pear-apps-utils-date": "git+https://github.com/tetherto/pear-apps-utils-date.git#28242e47629c327ae4c6687f6a883408917fa024",
    "@tetherto/pear-apps-utils-generate-unique-id": "git+https://github.com/tetherto/pear-apps-utils-generate-unique-id.git#a2a927374b353f26c05beda7f1052e4e1322027f",
    "@tetherto/pear-apps-utils-pattern-search": "git+https://github.com/tetherto/pear-apps-utils-pattern-search.git#0e593f8fcee9680342e7b4fa4be6a861a5c48f45",
    "@tetherto/pear-apps-utils-qr": "git+https://github.com/tetherto/pear-apps-utils-qr.git#0c3f32b3b3e9732aff190c5c7b60ed0f5beb02a7",
    "@tetherto/pear-apps-utils-validator": "git+https://github.com/tetherto/pear-apps-utils-validator.git#bf6b3b6ce3e5c773d6df6a1956a38e578ce0e7ff",
    "@tetherto/pearpass-lib-constants": "git+https://github.com/Thaoh/lockwright-lib-constants.git#0221dba94373926c7316c675d9bff774daf8464f",
    "@tetherto/pearpass-lib-ui-kit": "git+https://github.com/Thaoh/lockwright-lib-ui-react-native-components.git#4b254fff341c791a27a45f3e1488a3860f2b1987",
    "@tetherto/pearpass-lib-vault": "git+https://github.com/Thaoh/lockwright-lib-vault.git#e27dbb763e67d480463a11c4ae5e905c4cb002f8",
    "@tetherto/pearpass-utils-password-check": "git+https://github.com/tetherto/pearpass-utils-password-check.git#a549e2b4c486e5f57eb28acd47652ea38154d9c8",
    "@tetherto/pearpass-utils-password-generator": "git+https://github.com/tetherto/pearpass-utils-password-generator.git#ce69cd540a232550de361752d04450f0e600ca8a",
    "events": "3.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "9.2.0",
    "react-strict-dom": "0.0.55",
    "styled-components": "6.1.19",
    "tailwind-merge": "3.3.0",
    "tailwindcss": "4.1.4",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/preset-env": "7.26.9",
    "@babel/preset-react": "7.26.3",
    "@babel/preset-typescript": "7.28.5",
    "@lingui/babel-plugin-lingui-macro": "5.1.2",
    "@lingui/cli": "5.1.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@tetherto/tether-dev-docs": "github:tetherto/tether-dev-docs#64c264c34e8255360ca6c805457119168c789583",
    "@types/chrome": "0.1.36",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.27",
    "babel-jest": "29.7.0",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "knip": "6.14.1",
    "npm-run-all": "4.1.5",
    "pear-interface": "1.0.0",
    "postcss": "8.5.8",
    "prettier-plugin-tailwindcss": "0.6.11",
    "typescript": "5.9.3",
    "vite": "6.3.1",
    "vite-plugin-babel": "1.5.1"
  }
}
