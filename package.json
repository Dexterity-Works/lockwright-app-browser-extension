{
  "name": "lockwright-app-browser-extension",
  "private": true,
  "version": "0.0.29",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.10.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "dev": "vite",
    "build:main": "vite build --config vite.config.main.js",
    "build:content": "vite build --config vite.config.content.js",
    "build:background": "vite build --config vite.config.background.js",
    "build:inject": "vite build --config vite.config.inject.js",
    "build": "pnpm run lingui:extract && pnpm run lingui:compile && pnpm run build:main && pnpm run build:content && pnpm run build:background && pnpm run build:inject",
    "build:firefox": "pnpm run build && node scripts/package-firefox.mjs",
    "build:chrome": "pnpm run build && node scripts/package-chrome.mjs",
    "build:watch:main": "vite build --watch --config vite.config.main.js --mode development",
    "build:watch:content": "vite build --watch --config vite.config.content.js --mode development",
    "build:watch:background": "vite build --watch --config vite.config.background.js --mode development",
    "build:watch:inject": "vite build --watch --config vite.config.inject.js --mode development",
    "build:watch": "pnpm run lingui:extract && pnpm run lingui:compile && pnpm run --parallel \"/^build:watch:/\"",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "lint:fix": "eslint --fix ./src",
    "lint": "eslint ./src",
    "prepare": "husky",
    "lingui:extract": "lingui extract",
    "lingui:compile": "lingui compile",
    "knip": "knip"
  },
  "dependencies": {
    "@lingui/core": "5.1.2",
    "@lingui/format-json": "5.1.2",
    "@lingui/react": "5.1.2",
    "@lingui/vite-plugin": "5.3.1",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.6",
    "@tailwindcss/vite": "4.1.4",
    "lockwright-lib-ui-react-hooks": "git+https://github.com/Dexterity-Works/lockwright-lib-ui-react-hooks.git#56efd44bfc554e38604b1acce2f3ee904b2b16ce",
    "lockwright-utils-generate-unique-id": "git+https://github.com/Dexterity-Works/lockwright-utils-generate-unique-id.git#99a1450ca075c570fa08855280c8f73789cea07a",
    "lockwright-utils-pattern-search": "git+https://github.com/Dexterity-Works/lockwright-utils-pattern-search.git#37021914926a45d3f1ed1fd9c817db3ade370f25",
    "lockwright-utils-validator": "git+https://github.com/Dexterity-Works/lockwright-utils-validator.git#c9fc16de463fbc78df9bb1f3aa3f588a8ae06bf9",
    "lockwright-lib-constants": "git+https://github.com/Dexterity-Works/lockwright-lib-constants.git#701bf1988d16458c634db85269b436eb9c07cacc",
    "lockwright-lib-ui-react-native-components": "git+https://github.com/Dexterity-Works/lockwright-lib-ui-react-native-components.git#82167746355a4d1b931dae2c3d4abe10a7e10b7e",
    "lockwright-lib-vault": "git+https://github.com/Dexterity-Works/lockwright-lib-vault.git#7b16a0e53026b752d580a302052fdab1ea726b01",
    "lockwright-utils-password-check": "git+https://github.com/Dexterity-Works/lockwright-utils-password-check.git#3fb28bee9328290a12119feaaf912d1018fcf6f8",
    "lockwright-utils-password-generator": "git+https://github.com/Dexterity-Works/lockwright-utils-password-generator.git#382806f37823902b41087200c6d96bd83f3d3358",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-strict-dom": "0.0.55",
    "tailwindcss": "4.1.4",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/preset-env": "7.26.9",
    "@babel/preset-react": "7.26.3",
    "@babel/preset-typescript": "7.28.5",
    "@lingui/babel-plugin-lingui-macro": "5.1.2",
    "@lingui/cli": "5.1.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@tetherto/tether-dev-docs": "github:Dexterity-Works/tether-dev-docs#64c264c34e8255360ca6c805457119168c789583",
    "@types/chrome": "0.1.36",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "babel-jest": "29.7.0",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "knip": "6.14.1",
    "postcss": "8.5.8",
    "prettier-plugin-tailwindcss": "0.6.11",
    "typescript": "5.9.3",
    "vite": "6.3.1",
    "vite-plugin-babel": "1.5.1"
  }
}
