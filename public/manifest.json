{
  "manifest_version": 3,
  "name": "Lockwright",
  "version": "0.0.25",
  "permissions": [
    "storage",
    "nativeMessaging",
    "clipboardRead",
    "clipboardWrite",
    "offscreen",
    "alarms",
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lockwright@dexterity.works",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "Lockwright browser extension. Open-source, end-to-end encrypted password and identity manager.",
  "homepage_url": "https://lockwright.dexterity.works",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content-popups.html",
        "inject.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject-shim.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}